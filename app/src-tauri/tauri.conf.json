{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Shangxian",
  "version": "0.6.0",
  "identifier": "com.shangxian.zhushou",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "shangxian",
    "homepage": "https://github.com/iranolly/shangxian",
    "copyright": "Copyright © 2026 上线助手",
    "externalBin": [
      "binaries/cli"
    ],
    "resources": {
      "../../docs/AGENTS.md": "AGENTS.md",
      "../../skills/shangxian/SKILL.md": "SKILL.md"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "allowDowngrades": true,
      "nsis": {
        "languages": [
          "SimpChinese"
        ],
        "customLanguageFiles": {
          "SimpChinese": "nsis/SimpChinese.nsh"
        },
        "displayLanguageSelector": false,
        "installerHooks": "nsis/hooks.nsh",
        "startMenuFolder": "上线助手",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "uninstallerHeaderImage": "installer/header.bmp"
      }
    }
  }
}
